---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import { courseStepForTags, formatDateJa } from "../../utils/course";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { getSiteOrigin } from "../../utils/site-origin";
import { markTableCells } from "../../utils/table-cell";
import { buildToc } from "../../utils/toc";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
const siteOrigin = getSiteOrigin(Astro.url);

// SEO meta from content fields
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: siteOrigin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

// Taxonomy terms are already hydrated onto the entry by getEmDashEntry.
const tags = post.data.terms?.tag ?? [];
const course = courseStepForTags(tags);
const crumbTag = (course && tags.find((t) => t.slug === course.step.slug)) ?? tags[0];
const toc = buildToc(post.data.content);
const { publishedAt, updatedAt } = post.data;
const showUpdated =
	publishedAt && formatDateJa(updatedAt) !== formatDateJa(publishedAt);
// 料金の目安・動かした環境・動作確認日は任意のフィールド。空白だけの値は未入力として扱い、出さない
const costEstimate = post.data.cost_estimate?.trim() || null;
const runEnvironment = post.data.run_environment?.trim() || null;
const verifiedAt = post.data.verified_at?.trim() || null;
const verifiedAtLabel = verifiedAt ? formatIsoDateJa(verifiedAt) : null;

/** 動作確認日は時刻を持たない暦日（YYYY-MM-DD の文字列）。実在しない日付なら null を返し、入力をそのまま出す */
function formatIsoDateJa(value: string): string | null {
	const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
	if (!m) return null;
	const [year, month, day] = [Number(m[1]), Number(m[2]), Number(m[3])];
	// Date.UTC は 0〜99 年を 1900 年代に読み替えるので、setUTCFullYear で年をそのまま入れる
	const date = new Date(0);
	date.setUTCFullYear(year, month - 1, day);
	if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) return null;
	return `${year}年${month}月${day}日`;
}
// SEO パネルにも記事にも画像が無いときは、タイトルから作る OGP 画像を使う
const ogImage =
	seo.ogImage ?? new URL(`/og/posts/${encodeURIComponent(slug)}.svg`, siteOrigin).href;
const articleMeta = {
	publishedTime: publishedAt ? publishedAt.toISOString() : null,
	modifiedTime: updatedAt.toISOString(),
	author: post.data.byline?.displayName ?? null,
};
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={ogImage}
	pageType="article"
	articleMeta={articleMeta}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<div class="container article-layout">
		<article class="card article">
			<nav class="breadcrumb" aria-label="パンくず">
				<a href="/">トップ</a>{" / "}
				{crumbTag ? <a href={`/tag/${crumbTag.slug}`}>{crumbTag.label}</a> : <a href="/posts">記事一覧</a>}
				{" / 記事"}
			</nav>
			{course && <p class="eyebrow article__eyebrow">入門ステップ講座 {course.step.no} / {course.step.name}</p>}
			<h1 class="article__title" {...post.edit.title}>{post.data.title}</h1>
			{
				(publishedAt || verifiedAt) && (
					<p class="article__meta">
						{publishedAt && (
							<>
								公開 <time datetime={publishedAt.toISOString()}>{formatDateJa(publishedAt)}</time>
							</>
						)}
						{publishedAt && showUpdated && (
							<>
								{" ・ 更新 "}
								<time datetime={updatedAt.toISOString()}>{formatDateJa(updatedAt)}</time>
							</>
						)}
						{verifiedAt && (
							<span class="article__verified" data-verified-at>
								{publishedAt ? " ・ " : ""}動作確認日{" "}
								<time datetime={verifiedAtLabel ? verifiedAt : undefined}>{verifiedAtLabel ?? verifiedAt}</time>
							</span>
						)}
					</p>
				)
			}

			{
				(costEstimate || runEnvironment) && (
					<dl class="cost-box" data-cost-box>
						{costEstimate && (
							<div class="cost-box__row">
								<dt>料金の目安</dt>
								<dd>{costEstimate}</dd>
							</div>
						)}
						{runEnvironment && (
							<div class="cost-box__row">
								<dt>動かした環境</dt>
								<dd>{runEnvironment}</dd>
							</div>
						)}
					</dl>
				)
			}

			{
				toc.length > 0 && (
					<details class="toc toc--inline" data-toc-inline>
						<summary class="toc__title">目次</summary>
						<nav aria-label="目次" data-toc>
							<ol class="toc__list">
								{toc.map((item) => (
									<li>
										<a href={`#${item.id}`}>{item.text}</a>
									</li>
								))}
							</ol>
						</nav>
					</details>
				)
			}

			{
				post.data.featured_image && (
					<div class="article__image" {...post.edit.featured_image}>
						<Image image={post.data.featured_image} />
					</div>
				)
			}

			<div class="prose" data-prose>
				<PortableText value={markTableCells(post.data.content)} components={{ type: { code: CodeBlock } }} />
			</div>
			<p class="visually-hidden" role="status" aria-live="polite" data-copy-status></p>

			{
				tags.length > 0 && (
					<nav class="chips" aria-label="この記事のタグ">
						{tags.map((t) => (
							<a class="chip" href={`/tag/${t.slug}`}>{t.label}</a>
						))}
					</nav>
				)
			}

			{
				course && (course.prev || course.next) && (
					<nav class="step-nav" aria-label="講座の前後">
						{course.prev ? (
							<a href={`/tag/${course.prev.slug}`}>
								<span class="label">前のステップ</span>
								{course.prev.no} {course.prev.name}
							</a>
						) : (
							<span />
						)}
						{course.next && (
							<a class="is-next" href={`/tag/${course.next.slug}`}>
								<span class="label">次のステップ</span>
								{course.next.no} {course.next.name}
							</a>
						)}
					</nav>
				)
			}
		</article>

		<aside class="article-aside">
			{
				toc.length > 0 && (
					<nav class="card toc toc--aside" aria-label="目次" data-toc>
						<p class="toc__title">目次</p>
						<ol class="toc__list">
							{toc.map((item) => (
								<li>
									<a href={`#${item.id}`}>{item.text}</a>
								</li>
							))}
						</ol>
					</nav>
				)
			}
			<div class="gift-box">
				<p class="gift-box__title">動くサンプルアプリを受け取る</p>
				<p class="gift-box__text">RAG チャットと自作 MCP サーバー</p>
				<a class="btn btn--warm" href="/#gift">特典を見る</a>
			</div>
		</aside>
	</div>
</Base>

<script is:inline>
	// 目次（src/utils/toc.ts の buildToc）と同じ数え方で本文の h2 に id を振る。
	// buildToc は文字の無い h2 を飛ばすので、ここでも飛ばす。h2 に id が既にあるときは書き換えず、
	// 目次のリンク先をその id に合わせる
	(function () {
		var headings = document.querySelectorAll("[data-prose] h2");
		var n = 0;
		for (var i = 0; i < headings.length; i++) {
			if (!headings[i].textContent || !headings[i].textContent.trim()) continue;
			n++;
			var expected = "sec-" + n;
			if (!headings[i].id) {
				headings[i].id = expected;
			} else if (headings[i].id !== expected) {
				// 目次は狭い画面用（本文の前）と広い画面用（横の欄）の2つあるので、両方のリンクを合わせる
				var links = document.querySelectorAll('[data-toc] a[href="#' + expected + '"]');
				for (var j = 0; j < links.length; j++) links[j].setAttribute("href", "#" + headings[i].id);
			}
		}
	})();
</script>

<script is:inline>
	// コードブロックのコピーのボタン（src/components/CodeBlock.astro、#28）。JS が動くときだけボタンを出す。
	// 写すのは code 要素の文字そのもの。写せたか・写せなかったかは、ボタンの文字と読み上げ（role="status"）で伝える
	(function () {
		var status = document.querySelector("[data-copy-status]");
		var buttons = document.querySelectorAll("[data-copy-code]");
		function announce(text) {
			if (!status) return;
			// 同じ文をもう一度入れても読み上げられるように、一度空にしてから入れる
			status.textContent = "";
			setTimeout(function () {
				status.textContent = text;
			}, 50);
		}
		function fallbackCopy(text) {
			var area = document.createElement("textarea");
			area.value = text;
			area.setAttribute("readonly", "");
			area.style.position = "fixed";
			area.style.opacity = "0";
			document.body.appendChild(area);
			area.select();
			var ok = false;
			try {
				ok = document.execCommand("copy");
			} catch (e) {
				ok = false;
			}
			document.body.removeChild(area);
			return ok;
		}
		function copy(text) {
			if (navigator.clipboard && window.isSecureContext) {
				return navigator.clipboard.writeText(text).then(
					function () {
						return true;
					},
					function () {
						return fallbackCopy(text);
					},
				);
			}
			return Promise.resolve(fallbackCopy(text));
		}
		for (var i = 0; i < buttons.length; i++) {
			(function (button) {
				var block = button.closest("[data-code-block]");
				var code = block && block.querySelector("pre code");
				if (!code) return;
				var timer = null;
				button.hidden = false;
				button.addEventListener("click", function () {
					copy(code.textContent || "").then(function (ok) {
						button.textContent = ok ? "コピーしました" : "コピーできませんでした";
						button.dataset.state = ok ? "done" : "failed";
						announce(ok ? "コードをコピーしました" : "コピーできませんでした。コードを選んで写してください");
						clearTimeout(timer);
						timer = setTimeout(function () {
							button.textContent = "コピー";
							delete button.dataset.state;
						}, 2000);
					});
				});
			})(buttons[i]);
		}
	})();
</script>

<style>
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}
	.article-layout {
		padding-top: clamp(24px, 6vw, 40px);
		padding-bottom: clamp(48px, 9vw, 72px);
		display: flex;
		flex-wrap: wrap;
		gap: 40px;
		align-items: flex-start;
	}
	.article {
		flex: 999 1 560px;
		min-width: 0;
		padding: clamp(20px, 5vw, 40px);
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.article__eyebrow {
		font-size: 13px;
	}
	.article__title {
		margin: 0;
		font-size: clamp(24px, 5.4vw, 32px);
		line-height: 1.45;
	}
	.article__meta {
		margin: 0;
		font-size: 13px;
		color: var(--muted);
	}
	.cost-box {
		margin: 0;
		padding: 16px 20px;
		background: var(--accent-soft);
		border-radius: 8px;
		display: flex;
		flex-direction: column;
		gap: 8px;
		font-size: 14px;
		line-height: 1.7;
	}
	.cost-box__row {
		display: flex;
		flex-wrap: wrap;
		column-gap: 16px;
	}
	.cost-box dt {
		flex: 0 0 7em;
		font-weight: 700;
	}
	.cost-box dd {
		flex: 1 1 16em;
		margin: 0;
		min-width: 0;
		overflow-wrap: anywhere;
	}
	.article__image :global(img) {
		display: block;
		border-radius: 8px;
	}
	.article-aside {
		flex: 1 1 280px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	/* 本文（560px）と横の欄（280px）と間（40px）が並ぶ幅（880px + 左右の余白 48px）からは横に並べる。
	   それより狭いと横の欄は本文の後ろに回るので、目次は本文の前に折りたたんだ形（.toc--inline）で出す。
	   折り返しを幅の media query に合わせて決め、スクロールバーの幅で2つの目次が両方消える幅を作らない */
	@media (min-width: 928px) {
		.article-layout {
			flex-wrap: nowrap;
		}
		.article-aside {
			position: sticky;
			top: 24px;
		}
		.toc--inline {
			display: none;
		}
	}
	@media (max-width: 927.98px) {
		.toc--aside {
			display: none;
		}
	}
	/* 印刷では、閉じた details の中身が出ないので、今までどおり横の欄の目次（項目の一覧）を出す */
	@media print {
		.toc--inline {
			display: none;
		}
		.toc--aside {
			display: block;
		}
	}
	.toc {
		padding: 20px;
	}
	.toc__title {
		margin: 0 0 8px;
		font-weight: 700;
	}
	.toc--inline {
		padding: 12px 16px;
		border: 1px solid var(--line);
		border-radius: 8px;
	}
	.toc--inline .toc__title {
		margin: 0;
		cursor: pointer;
	}
	.toc--inline[open] .toc__title {
		margin-bottom: 8px;
	}
	.toc__list {
		margin: 0;
		padding-left: 20px;
		line-height: 2;
		font-size: 14px;
	}
	.gift-box {
		background: var(--warm-soft);
		border-radius: 12px;
		padding: 20px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.gift-box__title {
		margin: 0;
		font-weight: 700;
	}
	.gift-box__text {
		margin: 0;
		font-size: 14px;
		line-height: 1.7;
	}

	/* Portable Text の本文。デザインの見出し・コード・出典の見た目に合わせる */
	.prose {
		line-height: 1.9;
		overflow-wrap: anywhere;
	}
	.prose :global(> * + *) {
		margin-top: 20px;
	}
	.prose :global(p) {
		margin-bottom: 0;
	}
	.prose :global(> :first-child) {
		margin-top: 0;
	}
	.prose :global(h2) {
		margin: 32px 0 0;
		font-size: clamp(20px, 4.4vw, 24px);
		line-height: 1.5;
		scroll-margin-top: 16px;
	}
	.prose :global(h3) {
		margin: 28px 0 0;
		font-size: 19px;
		line-height: 1.5;
	}
	.prose :global(h4) {
		margin: 24px 0 0;
		font-size: 17px;
	}
	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 24px;
		margin-bottom: 0;
	}
	.prose :global(li + li) {
		margin-top: 4px;
	}
	.prose :global(pre) {
		margin-bottom: 0;
		background: var(--code-bg);
		color: var(--code-fg);
		padding: 20px;
		border-radius: 8px;
		overflow-x: auto;
		overflow-wrap: normal;
		font-family: var(--font-mono);
		font-size: 14px;
		line-height: 1.7;
	}
	.prose :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--output-bg);
		padding: 0.1em 0.35em;
		border-radius: 4px;
	}
	.prose :global(pre code) {
		background: none;
		padding: 0;
		font-size: inherit;
		color: inherit;
	}
	.prose :global(blockquote) {
		margin-left: 0;
		margin-right: 0;
		margin-bottom: 0;
		padding: 14px 16px;
		background: var(--accent-soft);
		border-radius: 8px;
	}
	.prose :global(table) {
		display: block;
		overflow-x: auto;
		border-collapse: collapse;
		font-size: 14px;
		overflow-wrap: normal;
	}
	/* 表の中で途中で折れてよいのは URL だけ（リンクと、markNumericTableCells が textAlign: "justify" を付けた URL のセル） */
	.prose :global(td a),
	.prose :global(th a),
	.prose :global(td[style*="text-align: justify"]) {
		overflow-wrap: anywhere;
	}
	.prose :global(th),
	.prose :global(td) {
		border: 1px solid var(--line);
		padding: 8px 12px;
		text-align: left;
	}
	/* 見出しの行は折らない。本文のセルは英単語・識別子の途中では折らず（日本語は文字の間で折れる）、
	   表が枠に収まらないときは .emdash-table-wrapper の中で横にスクロールする */
	.prose :global(th) {
		white-space: nowrap;
	}
	.prose :global(td) {
		min-width: 8ch;
		overflow-wrap: normal;
	}
	/* 番号・日付・バージョンのセル（markNumericTableCells が textAlign: "left" を付けたもの）は
	   2026-10-31 のハイフンで折らず、下限も付けない。表が枠より広いときは表が横にスクロールする */
	.prose :global(td[style*="text-align: left"]) {
		white-space: nowrap;
		min-width: 0;
	}
	/* 文と混ざったセルの中の日付・数字の並びは、markBreakableNumberRuns が underline の目印で
	   包んだもの。目印に使う線は消して、その並びだけ折れないようにする（原稿の文字は変えない） */
	.prose :global(td u) {
		text-decoration: none;
		white-space: nowrap;
	}
	.prose :global(img) {
		border-radius: 8px;
	}
</style>
