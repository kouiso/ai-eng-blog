{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "ai-eng-blog",
		"description": "自分のアプリに AI を組み込む開発を、実際に動かしたコードで学ぶブログ",
		"author": "ai-eng-blog"
	},
	"settings": {
		"title": "ai-eng-blog",
		"tagline": "自分のアプリに AI を組み込む開発を、実際に動かしたコードで学ぶブログ"
	},
	"collections": [
		{
			"slug": "posts",
			"label": "Posts",
			"labelSingular": "Post",
			"urlPattern": "/posts/{slug}",
			"supports": ["drafts", "revisions", "preview", "scheduling", "search", "seo"],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "featured_image",
					"label": "Featured Image",
					"type": "image"
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "excerpt",
					"label": "Excerpt",
					"type": "text"
				},
				{
					"slug": "cost_estimate",
					"label": "料金の目安",
					"type": "string"
				},
				{
					"slug": "run_environment",
					"label": "動かした環境",
					"type": "string"
				},
				{
					"slug": "verified_at",
					"label": "動作確認日（YYYY-MM-DD）",
					"type": "string",
					"validation": {
						"pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
					}
				}
			]
		},
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"urlPattern": "/{slug}",
			"supports": ["drafts", "revisions", "preview", "search", "seo"],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		}
	],
	"taxonomies": [
		{
			"name": "category",
			"label": "Categories",
			"labelSingular": "Category",
			"hierarchical": true,
			"collections": ["posts"],
			"terms": [
				{
					"slug": "general",
					"label": "General"
				},
				{
					"slug": "updates",
					"label": "Updates"
				}
			]
		},
		{
			"name": "tag",
			"label": "Tags",
			"labelSingular": "Tag",
			"hierarchical": false,
			"collections": ["posts"],
			"terms": [
				{
					"slug": "llm-api",
					"label": "LLM API"
				},
				{
					"slug": "structured-output",
					"label": "構造化出力"
				},
				{
					"slug": "rag",
					"label": "RAG"
				},
				{
					"slug": "ai-agent",
					"label": "AIエージェント"
				},
				{
					"slug": "mcp-server",
					"label": "MCPサーバー"
				},
				{
					"slug": "llm-eval",
					"label": "LLM 評価"
				}
			]
		}
	],
	"menus": [
		{
			"name": "primary",
			"label": "Primary Navigation",
			"items": [
				{
					"type": "custom",
					"label": "入門ステップ講座",
					"url": "/#course"
				},
				{
					"type": "custom",
					"label": "記事一覧",
					"url": "/posts"
				},
				{
					"type": "custom",
					"label": "特典",
					"url": "/#gift"
				}
			]
		}
	],
	"widgetAreas": [
		{
			"name": "sidebar",
			"label": "Sidebar",
			"description": "Sidebar widget area",
			"widgets": [
				{
					"type": "component",
					"componentId": "core:search",
					"title": "Search"
				},
				{
					"type": "component",
					"componentId": "core:categories",
					"title": "Categories"
				},
				{
					"type": "component",
					"componentId": "core:recent-posts",
					"title": "Recent Posts",
					"props": {
						"count": 5
					}
				}
			]
		}
	],
	"content": {
		"posts": [],
		"pages": []
	}
}
